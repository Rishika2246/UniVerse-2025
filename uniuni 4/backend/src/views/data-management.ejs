<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Data Management - UniVerse</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; 
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            color: #1a202c;
        }
        
        .header { 
            background: rgba(255,255,255,0.95); 
            backdrop-filter: blur(10px);
            padding: 30px; 
            text-align: center; 
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        }
        .header h1 { color: #667eea; margin-bottom: 10px; font-size: 2.5em; }
        .header p { color: #666; font-size: 1.2em; }
        
        .container { max-width: 1400px; margin: 0 auto; padding: 30px; }
        
        .stats-grid { 
            display: grid; 
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); 
            gap: 20px; 
            margin: 30px 0; 
        }
        .stat-card { 
            background: rgba(255,255,255,0.95); 
            backdrop-filter: blur(10px);
            border-radius: 15px; 
            padding: 25px; 
            text-align: center;
            box-shadow: 0 8px 32px rgba(0,0,0,0.1);
            transition: transform 0.3s ease;
        }
        .stat-card:hover { transform: translateY(-5px); }
        .stat-icon { font-size: 2.5em; margin-bottom: 10px; }
        .stat-value { font-size: 2.2em; font-weight: bold; color: #667eea; margin-bottom: 5px; }
        .stat-label { color: #666; font-size: 1em; }
        
        .actions-grid { 
            display: grid; 
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); 
            gap: 25px; 
            margin: 30px 0; 
        }
        .action-card { 
            background: rgba(255,255,255,0.95); 
            backdrop-filter: blur(10px);
            border-radius: 15px; 
            padding: 30px; 
            box-shadow: 0 8px 32px rgba(0,0,0,0.1);
        }
        .action-card h3 { 
            color: #667eea; 
            margin-bottom: 15px; 
            font-size: 1.3em;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .action-card p { 
            color: #666; 
            margin-bottom: 20px; 
            line-height: 1.6;
        }
        
        .btn { 
            padding: 12px 24px; 
            border: none; 
            border-radius: 8px; 
            cursor: pointer; 
            font-size: 1em;
            font-weight: 600;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
            margin: 5px;
        }
        .btn-primary { 
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white; 
        }
        .btn-primary:hover { 
            transform: translateY(-2px); 
            box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
        }
        .btn-success { 
            background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
            color: white; 
        }
        .btn-success:hover { 
            transform: translateY(-2px); 
            box-shadow: 0 6px 20px rgba(76, 175, 80, 0.4);
        }
        .btn-warning { 
            background: linear-gradient(135deg, #FF9800 0%, #F57C00 100%);
            color: white; 
        }
        .btn-warning:hover { 
            transform: translateY(-2px); 
            box-shadow: 0 6px 20px rgba(255, 152, 0, 0.4);
        }
        .btn-danger { 
            background: linear-gradient(135deg, #F44336 0%, #D32F2F 100%);
            color: white; 
        }
        .btn-danger:hover { 
            transform: translateY(-2px); 
            box-shadow: 0 6px 20px rgba(244, 67, 54, 0.4);
        }
        .btn:disabled { 
            opacity: 0.6; 
            cursor: not-allowed; 
            transform: none !important;
        }
        
        .output-area { 
            background: #2d3748; 
            color: #e2e8f0; 
            border-radius: 8px; 
            padding: 20px; 
            margin-top: 20px; 
            font-family: 'Monaco', monospace; 
            font-size: 0.9em;
            max-height: 400px;
            overflow-y: auto;
            display: none;
        }
        .output-header { 
            color: #4fd1c7; 
            margin-bottom: 10px; 
            font-weight: bold;
        }
        
        .progress-bar { 
            width: 100%; 
            height: 8px; 
            background: #e0e0e0; 
            border-radius: 4px; 
            overflow: hidden; 
            margin: 10px 0;
            display: none;
        }
        .progress-fill { 
            height: 100%; 
            background: linear-gradient(90deg, #667eea, #764ba2); 
            width: 0%; 
            transition: width 0.3s ease;
            animation: pulse 2s infinite;
        }
        @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.7; } }
        
        .recent-activity { 
            background: rgba(255,255,255,0.95); 
            backdrop-filter: blur(10px);
            border-radius: 15px; 
            padding: 30px; 
            margin: 30px 0;
            box-shadow: 0 8px 32px rgba(0,0,0,0.1);
        }
        .recent-activity h3 { 
            color: #667eea; 
            margin-bottom: 20px; 
            font-size: 1.3em;
        }
        .activity-item { 
            padding: 15px; 
            margin: 10px 0; 
            background: #f8f9fa; 
            border-radius: 8px; 
            border-left: 4px solid #667eea;
        }
        .activity-time { 
            font-size: 0.8em; 
            color: #666; 
            margin-top: 5px;
        }
        
        .nav-links { 
            display: flex; 
            gap: 15px; 
            margin-bottom: 30px; 
            flex-wrap: wrap;
        }
        .nav-link { 
            background: rgba(255,255,255,0.9); 
            color: #667eea; 
            padding: 10px 20px; 
            border-radius: 25px; 
            text-decoration: none; 
            font-weight: 600;
            transition: all 0.3s ease;
        }
        .nav-link:hover { 
            background: white; 
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
        
        .loading { 
            display: inline-block; 
            width: 20px; 
            height: 20px; 
            border: 3px solid #f3f3f3; 
            border-top: 3px solid #667eea; 
            border-radius: 50%; 
            animation: spin 1s linear infinite; 
            margin-right: 10px;
        }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    </style>
</head>
<body>
    <div class="header">
        <h1>🗄️ Data Management Center</h1>
        <p>Comprehensive Database Management & Seeding Operations</p>
    </div>

    <div class="container">
        <!-- Navigation Links -->
        <div class="nav-links">
            <a href="/data" class="nav-link">🗄️ Data Browser</a>
            <a href="/admin" class="nav-link">🎯 Admin Dashboard</a>
            <a href="http://localhost:5556" target="_blank" class="nav-link">🎨 Prisma Studio</a>
            <a href="/api/playground" class="nav-link">🎮 API Playground</a>
        </div>

        <!-- Database Statistics -->
        <div class="stats-grid" id="statsGrid">
            <div class="stat-card">
                <div class="stat-icon">👥</div>
                <div class="stat-value" id="usersCount">Loading...</div>
                <div class="stat-label">Total Users</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">📚</div>
                <div class="stat-value" id="coursesCount">Loading...</div>
                <div class="stat-label">Courses</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">📝</div>
                <div class="stat-value" id="examsCount">Loading...</div>
                <div class="stat-label">Exams</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">🪑</div>
                <div class="stat-value" id="seatsCount">Loading...</div>
                <div class="stat-label">Total Seats</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">🎫</div>
                <div class="stat-value" id="hallTicketsCount">Loading...</div>
                <div class="stat-label">Hall Tickets</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">🧠</div>
                <div class="stat-value" id="mindMapsCount">Loading...</div>
                <div class="stat-label">Mind Maps</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">🎭</div>
                <div class="stat-value" id="clubsCount">Loading...</div>
                <div class="stat-label">Clubs</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">🎪</div>
                <div class="stat-value" id="eventsCount">Loading...</div>
                <div class="stat-label">Events</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">📊</div>
                <div class="stat-value" id="studentsCount">Loading...</div>
                <div class="stat-label">CSV Students</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">📈</div>
                <div class="stat-value" id="gradesCount">Loading...</div>
                <div class="stat-label">Grades</div>
            </div>
        </div>

        <!-- Data Management Actions -->
        <div class="actions-grid">
            <!-- Massive Seed -->
            <div class="action-card">
                <h3>🚀 Massive Data Seeding</h3>
                <p>Generate comprehensive test data with 500+ records in each table. This includes users, courses, exams, seating allocations, mind maps, clubs, events, and more.</p>
                <button class="btn btn-success" onclick="runMassiveSeed()" id="massiveSeedBtn">
                    🌱 Generate 500+ Records Each
                </button>
                <div class="progress-bar" id="massiveSeedProgress">
                    <div class="progress-fill"></div>
                </div>
                <div class="output-area" id="massiveSeedOutput">
                    <div class="output-header">Seeding Output:</div>
                    <pre id="massiveSeedContent"></pre>
                </div>
            </div>

            <!-- CSV Import -->
            <div class="action-card">
                <h3>📊 CSV Student Data Import</h3>
                <p>Import student performance data from CSV files. This includes math and Portuguese student records with grades and demographic information.</p>
                <button class="btn btn-primary" onclick="importCSV()" id="csvImportBtn">
                    📥 Import CSV Data
                </button>
                <div class="progress-bar" id="csvImportProgress">
                    <div class="progress-fill"></div>
                </div>
                <div class="output-area" id="csvImportOutput">
                    <div class="output-header">Import Output:</div>
                    <pre id="csvImportContent"></pre>
                </div>
            </div>

            <!-- Database Reset -->
            <div class="action-card">
                <h3>🔄 Database Reset</h3>
                <p>Reset the entire database, clear all data, and run migrations. This will restore the database to a clean state with the basic seed data.</p>
                <button class="btn btn-warning" onclick="resetDatabase()" id="resetBtn">
                    🔄 Reset & Reseed Database
                </button>
                <div class="progress-bar" id="resetProgress">
                    <div class="progress-fill"></div>
                </div>
                <div class="output-area" id="resetOutput">
                    <div class="output-header">Reset Output:</div>
                    <pre id="resetContent"></pre>
                </div>
            </div>

            <!-- Clear Data -->
            <div class="action-card">
                <h3>🗑️ Clear All Data</h3>
                <p>Remove all data from the database while keeping the schema intact. This is useful for starting fresh without running migrations.</p>
                <button class="btn btn-danger" onclick="clearData()" id="clearBtn">
                    🗑️ Clear All Data
                </button>
                <div class="progress-bar" id="clearProgress">
                    <div class="progress-fill"></div>
                </div>
                <div class="output-area" id="clearOutput">
                    <div class="output-header">Clear Output:</div>
                    <pre id="clearContent"></pre>
                </div>
            </div>
        </div>

        <!-- Recent Activity -->
        <div class="recent-activity">
            <h3>📈 Recent Database Activity</h3>
            <div id="recentActivity">Loading recent activity...</div>
        </div>
    </div>

    <script>
        // Load statistics on page load
        async function loadStats() {
            try {
                const response = await fetch('/api/data-management/stats');
                const data = await response.json();
                
                // Update stat cards
                document.getElementById('usersCount').textContent = data.summary.users;
                document.getElementById('coursesCount').textContent = data.summary.courses;
                document.getElementById('examsCount').textContent = data.summary.exams;
                document.getElementById('seatsCount').textContent = data.summary.seats;
                document.getElementById('hallTicketsCount').textContent = data.summary.hallTickets;
                document.getElementById('mindMapsCount').textContent = data.summary.mindMaps;
                document.getElementById('clubsCount').textContent = data.summary.clubs;
                document.getElementById('eventsCount').textContent = data.summary.events;
                document.getElementById('studentsCount').textContent = data.summary.students;
                document.getElementById('gradesCount').textContent = data.summary.grades;
                
                // Update recent activity
                let activityHtml = '';
                if (data.recent.users.length > 0) {
                    activityHtml += '<h4>Recent Users:</h4>';
                    data.recent.users.forEach(user => {
                        activityHtml += `
                            <div class="activity-item">
                                <strong>${user.fullName}</strong> (${user.email}) joined
                                <div class="activity-time">${new Date(user.createdAt).toLocaleString()}</div>
                            </div>
                        `;
                    });
                }
                
                if (data.recent.exams.length > 0) {
                    activityHtml += '<h4>Recent Exams:</h4>';
                    data.recent.exams.forEach(exam => {
                        activityHtml += `
                            <div class="activity-item">
                                <strong>${exam.course.name}</strong> (${exam.course.code}) - ${exam.examType}
                                <div class="activity-time">${new Date(exam.createdAt).toLocaleString()}</div>
                            </div>
                        `;
                    });
                }
                
                document.getElementById('recentActivity').innerHTML = activityHtml || '<p>No recent activity</p>';
                
            } catch (error) {
                console.error('Error loading stats:', error);
            }
        }

        // Run massive seed
        async function runMassiveSeed() {
            const btn = document.getElementById('massiveSeedBtn');
            const progress = document.getElementById('massiveSeedProgress');
            const output = document.getElementById('massiveSeedOutput');
            const content = document.getElementById('massiveSeedContent');
            
            btn.disabled = true;
            btn.innerHTML = '<span class="loading"></span>Seeding Database...';
            progress.style.display = 'block';
            output.style.display = 'block';
            content.textContent = 'Starting massive seed operation...\n';
            
            try {
                const response = await fetch('/api/data-management/seed/massive', {
                    method: 'POST'
                });
                const result = await response.json();
                
                if (result.success) {
                    content.textContent = result.output;
                    btn.innerHTML = '✅ Seeding Completed!';
                    btn.className = 'btn btn-success';
                    setTimeout(() => {
                        loadStats();
                        btn.innerHTML = '🌱 Generate 500+ Records Each';
                        btn.disabled = false;
                    }, 3000);
                } else {
                    content.textContent = `Error: ${result.error}\n\nOutput: ${result.output}`;
                    btn.innerHTML = '❌ Seeding Failed';
                    btn.className = 'btn btn-danger';
                    setTimeout(() => {
                        btn.innerHTML = '🌱 Generate 500+ Records Each';
                        btn.className = 'btn btn-success';
                        btn.disabled = false;
                    }, 5000);
                }
            } catch (error) {
                content.textContent = `Network error: ${error.message}`;
                btn.innerHTML = '❌ Network Error';
                btn.className = 'btn btn-danger';
                setTimeout(() => {
                    btn.innerHTML = '🌱 Generate 500+ Records Each';
                    btn.className = 'btn btn-success';
                    btn.disabled = false;
                }, 5000);
            }
            
            progress.style.display = 'none';
        }

        // Import CSV
        async function importCSV() {
            const btn = document.getElementById('csvImportBtn');
            const progress = document.getElementById('csvImportProgress');
            const output = document.getElementById('csvImportOutput');
            const content = document.getElementById('csvImportContent');
            
            btn.disabled = true;
            btn.innerHTML = '<span class="loading"></span>Importing CSV...';
            progress.style.display = 'block';
            output.style.display = 'block';
            content.textContent = 'Starting CSV import...\n';
            
            try {
                const response = await fetch('/api/data-management/import/csv', {
                    method: 'POST'
                });
                const result = await response.json();
                
                if (result.success) {
                    content.textContent = result.output;
                    btn.innerHTML = '✅ Import Completed!';
                    btn.className = 'btn btn-success';
                    setTimeout(() => {
                        loadStats();
                        btn.innerHTML = '📥 Import CSV Data';
                        btn.className = 'btn btn-primary';
                        btn.disabled = false;
                    }, 3000);
                } else {
                    content.textContent = `Error: ${result.error}\n\nOutput: ${result.output}`;
                    btn.innerHTML = '❌ Import Failed';
                    btn.className = 'btn btn-danger';
                    setTimeout(() => {
                        btn.innerHTML = '📥 Import CSV Data';
                        btn.className = 'btn btn-primary';
                        btn.disabled = false;
                    }, 5000);
                }
            } catch (error) {
                content.textContent = `Network error: ${error.message}`;
                btn.innerHTML = '❌ Network Error';
                btn.className = 'btn btn-danger';
                setTimeout(() => {
                    btn.innerHTML = '📥 Import CSV Data';
                    btn.className = 'btn btn-primary';
                    btn.disabled = false;
                }, 5000);
            }
            
            progress.style.display = 'none';
        }

        // Reset database
        async function resetDatabase() {
            if (!confirm('Are you sure you want to reset the entire database? This will delete ALL data!')) {
                return;
            }
            
            const btn = document.getElementById('resetBtn');
            const progress = document.getElementById('resetProgress');
            const output = document.getElementById('resetOutput');
            const content = document.getElementById('resetContent');
            
            btn.disabled = true;
            btn.innerHTML = '<span class="loading"></span>Resetting Database...';
            progress.style.display = 'block';
            output.style.display = 'block';
            content.textContent = 'Starting database reset...\n';
            
            try {
                const response = await fetch('/api/data-management/reset', {
                    method: 'POST'
                });
                const result = await response.json();
                
                if (result.success) {
                    content.textContent = result.output;
                    btn.innerHTML = '✅ Reset Completed!';
                    btn.className = 'btn btn-success';
                    setTimeout(() => {
                        loadStats();
                        btn.innerHTML = '🔄 Reset & Reseed Database';
                        btn.className = 'btn btn-warning';
                        btn.disabled = false;
                    }, 3000);
                } else {
                    content.textContent = `Error: ${result.error}\n\nOutput: ${result.output}`;
                    btn.innerHTML = '❌ Reset Failed';
                    btn.className = 'btn btn-danger';
                    setTimeout(() => {
                        btn.innerHTML = '🔄 Reset & Reseed Database';
                        btn.className = 'btn btn-warning';
                        btn.disabled = false;
                    }, 5000);
                }
            } catch (error) {
                content.textContent = `Network error: ${error.message}`;
                btn.innerHTML = '❌ Network Error';
                btn.className = 'btn btn-danger';
                setTimeout(() => {
                    btn.innerHTML = '🔄 Reset & Reseed Database';
                    btn.className = 'btn btn-warning';
                    btn.disabled = false;
                }, 5000);
            }
            
            progress.style.display = 'none';
        }

        // Clear data
        async function clearData() {
            if (!confirm('Are you sure you want to clear all data? This cannot be undone!')) {
                return;
            }
            
            const btn = document.getElementById('clearBtn');
            const progress = document.getElementById('clearProgress');
            const output = document.getElementById('clearOutput');
            const content = document.getElementById('clearContent');
            
            btn.disabled = true;
            btn.innerHTML = '<span class="loading"></span>Clearing Data...';
            progress.style.display = 'block';
            output.style.display = 'block';
            content.textContent = 'Starting data clearing...\n';
            
            try {
                const response = await fetch('/api/data-management/clear', {
                    method: 'POST'
                });
                const result = await response.json();
                
                if (result.success) {
                    content.textContent = 'All data cleared successfully!';
                    btn.innerHTML = '✅ Data Cleared!';
                    btn.className = 'btn btn-success';
                    setTimeout(() => {
                        loadStats();
                        btn.innerHTML = '🗑️ Clear All Data';
                        btn.className = 'btn btn-danger';
                        btn.disabled = false;
                    }, 3000);
                } else {
                    content.textContent = `Error: ${result.error}`;
                    btn.innerHTML = '❌ Clear Failed';
                    btn.className = 'btn btn-danger';
                    setTimeout(() => {
                        btn.innerHTML = '🗑️ Clear All Data';
                        btn.disabled = false;
                    }, 5000);
                }
            } catch (error) {
                content.textContent = `Network error: ${error.message}`;
                btn.innerHTML = '❌ Network Error';
                setTimeout(() => {
                    btn.innerHTML = '🗑️ Clear All Data';
                    btn.disabled = false;
                }, 5000);
            }
            
            progress.style.display = 'none';
        }

        // Load stats on page load
        loadStats();
        
        // Auto-refresh stats every 30 seconds
        setInterval(loadStats, 30000);
    </script>
</body>
</html>