<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UniVerse Demo Credentials</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            color: #333;
            padding: 20px;
        }
        .header { 
            background: rgba(255,255,255,0.95); 
            backdrop-filter: blur(10px);
            padding: 40px; 
            text-align: center; 
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
            border-radius: 20px;
            margin-bottom: 30px;
        }
        .header h1 { color: #667eea; margin-bottom: 15px; font-size: 3em; }
        .header p { color: #666; font-size: 1.3em; }
        .container { max-width: 1200px; margin: 0 auto; }
        
        .credentials-grid { 
            display: grid; 
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); 
            gap: 25px; 
            margin: 30px 0; 
        }
        .credential-card { 
            background: rgba(255,255,255,0.95); 
            backdrop-filter: blur(10px);
            border-radius: 20px; 
            padding: 30px; 
            box-shadow: 0 8px 32px rgba(0,0,0,0.1);
            transition: all 0.3s ease;
            border-top: 5px solid;
        }
        .credential-card:hover { 
            transform: translateY(-10px); 
            box-shadow: 0 15px 40px rgba(0,0,0,0.2);
        }
        
        .admin-card { border-top-color: #e74c3c; }
        .faculty-card { border-top-color: #3498db; }
        .student-card { border-top-color: #2ecc71; }
        .seating-card { border-top-color: #f39c12; }
        .club-card { border-top-color: #9b59b6; }
        
        .role-icon { 
            font-size: 4em; 
            text-align: center; 
            margin-bottom: 20px; 
        }
        .role-title { 
            font-size: 1.8em; 
            font-weight: bold; 
            text-align: center; 
            margin-bottom: 20px; 
            color: #333;
        }
        .credential-info { 
            background: #f8f9fa; 
            border-radius: 10px; 
            padding: 20px; 
            margin: 15px 0;
        }
        .credential-label { 
            font-weight: bold; 
            color: #666; 
            margin-bottom: 5px; 
            font-size: 0.9em;
            text-transform: uppercase;
        }
        .credential-value { 
            font-family: 'Monaco', monospace; 
            background: #e9ecef; 
            padding: 8px 12px; 
            border-radius: 5px; 
            margin-bottom: 10px;
            font-size: 1em;
            word-break: break-all;
        }
        .copy-btn { 
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white; 
            border: none; 
            padding: 8px 15px; 
            border-radius: 15px; 
            cursor: pointer; 
            font-size: 0.8em;
            transition: all 0.3s ease;
            margin-left: 10px;
        }
        .copy-btn:hover { transform: scale(1.05); }
        
        .test-login { 
            background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
            color: white; 
            border: none; 
            padding: 15px 25px; 
            border-radius: 25px; 
            cursor: pointer; 
            font-size: 1em;
            font-weight: bold;
            width: 100%;
            margin-top: 20px;
            transition: all 0.3s ease;
        }
        .test-login:hover { 
            transform: translateY(-2px); 
            box-shadow: 0 5px 15px rgba(76, 175, 80, 0.4);
        }
        
        .usage-guide { 
            background: rgba(255,255,255,0.95); 
            backdrop-filter: blur(10px);
            border-radius: 20px; 
            padding: 30px; 
            margin: 30px 0;
            box-shadow: 0 8px 32px rgba(0,0,0,0.1);
        }
        .usage-guide h2 { 
            color: #667eea; 
            margin-bottom: 20px; 
            text-align: center;
            font-size: 2em;
        }
        .guide-step { 
            background: #f8f9fa; 
            border-radius: 10px; 
            padding: 20px; 
            margin: 15px 0;
            border-left: 4px solid #667eea;
        }
        .step-number { 
            background: #667eea; 
            color: white; 
            width: 30px; 
            height: 30px; 
            border-radius: 50%; 
            display: inline-flex; 
            align-items: center; 
            justify-content: center; 
            font-weight: bold; 
            margin-right: 15px;
        }
        
        .api-endpoints { 
            background: rgba(255,255,255,0.95); 
            backdrop-filter: blur(10px);
            border-radius: 20px; 
            padding: 30px; 
            margin: 30px 0;
            box-shadow: 0 8px 32px rgba(0,0,0,0.1);
        }
        .api-endpoints h2 { 
            color: #667eea; 
            margin-bottom: 20px; 
            text-align: center;
            font-size: 2em;
        }
        .endpoint-links { 
            display: grid; 
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); 
            gap: 15px; 
        }
        .endpoint-link { 
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white; 
            padding: 15px 20px; 
            border-radius: 10px; 
            text-decoration: none; 
            text-align: center;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
        }
        .endpoint-link:hover { 
            transform: translateY(-3px); 
            box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
        }
        
        .back-btn { 
            position: fixed; 
            top: 20px; 
            left: 20px; 
            background: rgba(255,255,255,0.9); 
            border: none; 
            padding: 10px 15px; 
            border-radius: 25px; 
            cursor: pointer; 
            font-size: 1.2em;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            transition: all 0.3s ease;
        }
        .back-btn:hover { 
            background: white; 
            transform: scale(1.05);
        }
    </style>
</head>
<body>
    <button class="back-btn" onclick="history.back()">← Back</button>
    
    <div class="container">
        <div class="header">
            <h1>🔑 Demo Credentials</h1>
            <p>Test accounts for exploring UniVerse Academic Management System</p>
        </div>

        <div class="credentials-grid">
            <!-- Admin Account -->
            <div class="credential-card admin-card">
                <div class="role-icon">👨‍💼</div>
                <div class="role-title">System Administrator</div>
                <div class="credential-info">
                    <div class="credential-label">Email Address</div>
                    <div class="credential-value">
                        admin@university.edu
                        <button class="copy-btn" onclick="copyToClipboard('admin@university.edu')">📋 Copy</button>
                    </div>
                    <div class="credential-label">Password</div>
                    <div class="credential-value">
                        admin123
                        <button class="copy-btn" onclick="copyToClipboard('admin123')">📋 Copy</button>
                    </div>
                </div>
                <button class="test-login" onclick="testLogin('admin@university.edu', 'admin123')">🚀 Test Login</button>
            </div>

            <!-- Faculty Account -->
            <div class="credential-card faculty-card">
                <div class="role-icon">👨‍🏫</div>
                <div class="role-title">Faculty Member</div>
                <div class="credential-info">
                    <div class="credential-label">Email Address</div>
                    <div class="credential-value">
                        faculty1@university.edu
                        <button class="copy-btn" onclick="copyToClipboard('faculty1@university.edu')">📋 Copy</button>
                    </div>
                    <div class="credential-label">Password</div>
                    <div class="credential-value">
                        faculty123
                        <button class="copy-btn" onclick="copyToClipboard('faculty123')">📋 Copy</button>
                    </div>
                </div>
                <button class="test-login" onclick="testLogin('faculty1@university.edu', 'faculty123')">🚀 Test Login</button>
            </div>

            <!-- Student Account -->
            <div class="credential-card student-card">
                <div class="role-icon">👨‍🎓</div>
                <div class="role-title">Student</div>
                <div class="credential-info">
                    <div class="credential-label">Email Address</div>
                    <div class="credential-value">
                        student1@university.edu
                        <button class="copy-btn" onclick="copyToClipboard('student1@university.edu')">📋 Copy</button>
                    </div>
                    <div class="credential-label">Password</div>
                    <div class="credential-value">
                        student123
                        <button class="copy-btn" onclick="copyToClipboard('student123')">📋 Copy</button>
                    </div>
                </div>
                <button class="test-login" onclick="testLogin('student1@university.edu', 'student123')">🚀 Test Login</button>
            </div>

            <!-- Seating Manager Account -->
            <div class="credential-card seating-card">
                <div class="role-icon">🪑</div>
                <div class="role-title">Seating Manager</div>
                <div class="credential-info">
                    <div class="credential-label">Email Address</div>
                    <div class="credential-value">
                        seating1@university.edu
                        <button class="copy-btn" onclick="copyToClipboard('seating1@university.edu')">📋 Copy</button>
                    </div>
                    <div class="credential-label">Password</div>
                    <div class="credential-value">
                        seat123
                        <button class="copy-btn" onclick="copyToClipboard('seat123')">📋 Copy</button>
                    </div>
                </div>
                <button class="test-login" onclick="testLogin('seating1@university.edu', 'seat123')">🚀 Test Login</button>
            </div>

            <!-- Club Coordinator Account -->
            <div class="credential-card club-card">
                <div class="role-icon">🎭</div>
                <div class="role-title">Club Coordinator</div>
                <div class="credential-info">
                    <div class="credential-label">Email Address</div>
                    <div class="credential-value">
                        clubcoord1@university.edu
                        <button class="copy-btn" onclick="copyToClipboard('clubcoord1@university.edu')">📋 Copy</button>
                    </div>
                    <div class="credential-label">Password</div>
                    <div class="credential-value">
                        coord123
                        <button class="copy-btn" onclick="copyToClipboard('coord123')">📋 Copy</button>
                    </div>
                </div>
                <button class="test-login" onclick="testLogin('clubcoord1@university.edu', 'coord123')">🚀 Test Login</button>
            </div>
        </div>

        <div class="usage-guide">
            <h2>📖 How to Use These Credentials</h2>
            <div class="guide-step">
                <span class="step-number">1</span>
                <strong>Choose a Role:</strong> Select the account type that matches the functionality you want to test (Admin for full access, Student for student features, etc.)
            </div>
            <div class="guide-step">
                <span class="step-number">2</span>
                <strong>Copy Credentials:</strong> Use the copy buttons to copy the email and password to your clipboard
            </div>
            <div class="guide-step">
                <span class="step-number">3</span>
                <strong>Test Login:</strong> Click the "Test Login" button to automatically test the authentication API, or use the credentials in your frontend application
            </div>
            <div class="guide-step">
                <span class="step-number">4</span>
                <strong>Explore Features:</strong> Once logged in, explore the role-specific features and functionalities available to that user type
            </div>
        </div>

        <div class="api-endpoints">
            <h2>🔗 Quick Access Links</h2>
            <div class="endpoint-links">
                <a href="/admin" class="endpoint-link">🎯 Admin Dashboard</a>
                <a href="/api/playground" class="endpoint-link">🎮 API Playground</a>
                <a href="/api/status/health" class="endpoint-link">🏥 Health Check</a>
                <a href="/api/courses" class="endpoint-link">📚 Courses API</a>
                <a href="/api/exams" class="endpoint-link">📝 Exams API</a>
                <a href="/api/users" class="endpoint-link">👥 Users API</a>
            </div>
        </div>
    </div>

    <script>
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(() => {
                // Show temporary success message
                const btn = event.target;
                const originalText = btn.textContent;
                btn.textContent = '✅ Copied!';
                btn.style.background = '#4CAF50';
                setTimeout(() => {
                    btn.textContent = originalText;
                    btn.style.background = '';
                }, 2000);
            }).catch(err => {
                console.error('Failed to copy: ', err);
                alert('Failed to copy to clipboard');
            });
        }

        async function testLogin(email, password) {
            const btn = event.target;
            const originalText = btn.textContent;
            btn.textContent = '🔄 Testing...';
            btn.disabled = true;

            try {
                const response = await fetch('/api/auth/login', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ email, password })
                });

                const result = await response.json();

                if (response.ok) {
                    btn.textContent = '✅ Login Success!';
                    btn.style.background = '#4CAF50';
                    alert(`Login successful for ${email}!\n\nResponse: ${JSON.stringify(result, null, 2)}`);
                } else {
                    btn.textContent = '❌ Login Failed';
                    btn.style.background = '#F44336';
                    alert(`Login failed for ${email}\n\nError: ${result.message || 'Unknown error'}`);
                }
            } catch (error) {
                btn.textContent = '❌ Network Error';
                btn.style.background = '#F44336';
                alert(`Network error: ${error.message}`);
            }

            setTimeout(() => {
                btn.textContent = originalText;
                btn.style.background = '';
                btn.disabled = false;
            }, 3000);
        }
    </script>
</body>
</html>