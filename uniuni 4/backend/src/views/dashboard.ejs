<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UniVerse Backend Dashboard</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            color: #333;
        }
        .header { 
            background: rgba(255,255,255,0.95); 
            backdrop-filter: blur(10px);
            color: #333; 
            padding: 30px; 
            text-align: center; 
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        }
        .header h1 { color: #667eea; margin-bottom: 10px; font-size: 2.5em; }
        .header p { color: #666; font-size: 1.2em; }
        .container { max-width: 1400px; margin: 0 auto; padding: 30px; }
        .grid { 
            display: grid; 
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); 
            gap: 20px; 
            margin: 20px 0; 
        }
        .full-width { 
            grid-column: 1 / -1; 
        }
        .card { 
            background: rgba(255,255,255,0.95); 
            backdrop-filter: blur(10px);
            border-radius: 15px; 
            padding: 25px; 
            box-shadow: 0 8px 32px rgba(0,0,0,0.1);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .card:hover { 
            transform: translateY(-5px); 
            box-shadow: 0 12px 40px rgba(0,0,0,0.15);
        }
        .card h3 { 
            color: #667eea; 
            margin-bottom: 20px; 
            border-bottom: 3px solid #667eea; 
            padding-bottom: 12px; 
            font-size: 1.3em;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .stat { 
            display: flex; 
            justify-content: space-between; 
            margin: 15px 0; 
            padding: 10px 0;
            border-bottom: 1px solid #f0f0f0;
        }
        .stat:last-child { border-bottom: none; }
        .stat-label { font-weight: 500; color: #555; }
        .stat-value { font-weight: bold; color: #667eea; font-size: 1.1em; }
        .status-indicator { 
            display: inline-block; 
            width: 12px; 
            height: 12px; 
            border-radius: 50%; 
            margin-right: 10px;
            box-shadow: 0 0 10px rgba(0,0,0,0.3);
        }
        .status-healthy { background: #4CAF50; box-shadow: 0 0 10px rgba(76, 175, 80, 0.5); }
        .status-warning { background: #FF9800; box-shadow: 0 0 10px rgba(255, 152, 0, 0.5); }
        .status-error { background: #F44336; box-shadow: 0 0 10px rgba(244, 67, 54, 0.5); }
        .service-list { list-style: none; }
        .service-item { 
            padding: 12px 0; 
            border-bottom: 1px solid #f0f0f0; 
            display: flex;
            align-items: center;
            transition: background 0.3s ease;
        }
        .service-item:hover { background: rgba(102, 126, 234, 0.05); }
        .service-item:last-child { border-bottom: none; }
        .recent-activity { max-height: 350px; overflow-y: auto; }
        .activity-item { 
            padding: 15px; 
            margin: 10px 0; 
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); 
            border-radius: 10px; 
            border-left: 4px solid #667eea;
            transition: all 0.3s ease;
        }
        .activity-item:hover { 
            background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%); 
            transform: translateX(5px);
        }
        .alert { 
            padding: 15px; 
            margin: 15px 0; 
            border-radius: 10px; 
            border-left: 4px solid;
            backdrop-filter: blur(10px);
        }
        .alert-info { 
            background: rgba(227, 242, 253, 0.9); 
            border-color: #2196f3; 
            color: #1565c0; 
        }
        .alert-warning { 
            background: rgba(255, 243, 224, 0.9); 
            border-color: #ff9800; 
            color: #ef6c00; 
        }
        .alert-success { 
            background: rgba(232, 245, 233, 0.9); 
            border-color: #4caf50; 
            color: #2e7d32; 
        }
        .refresh-btn { 
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white; 
            border: none; 
            padding: 15px 30px; 
            border-radius: 25px; 
            cursor: pointer; 
            font-size: 1.1em;
            font-weight: bold;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
        }
        .refresh-btn:hover { 
            transform: translateY(-2px); 
            box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
        }
        .api-links { 
            display: grid; 
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); 
            gap: 15px; 
            margin: 20px 0; 
        }
        .api-link { 
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white; 
            padding: 15px 20px; 
            border-radius: 10px; 
            text-decoration: none; 
            font-size: 0.95em;
            text-align: center;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
        }
        .api-link:hover { 
            transform: translateY(-3px); 
            box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
        }
        .loading { 
            display: inline-block; 
            width: 24px; 
            height: 24px; 
            border: 3px solid #f3f3f3; 
            border-top: 3px solid #667eea; 
            border-radius: 50%; 
            animation: spin 1s linear infinite; 
        }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        
        .refresh-btn { 
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white; 
            border: none; 
            padding: 8px 16px; 
            border-radius: 20px; 
            cursor: pointer; 
            font-size: 0.9em;
            margin-top: 15px;
            transition: transform 0.3s ease;
        }
        .refresh-btn:hover { transform: scale(1.05); }
        
        .hero-stats { 
            display: grid; 
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); 
            gap: 15px; 
            margin: 20px 0; 
            max-width: 800px;
        }
        .hero-stat { 
            background: rgba(255,255,255,0.95); 
            backdrop-filter: blur(10px);
            border-radius: 12px; 
            padding: 18px; 
            text-align: center;
            box-shadow: 0 6px 24px rgba(0,0,0,0.1);
            transition: transform 0.3s ease;
        }
        .hero-stat:hover { transform: translateY(-3px); }
        .hero-stat-icon { font-size: 2em; margin-bottom: 8px; }
        .hero-stat-value { font-size: 1.8em; font-weight: bold; color: #667eea; margin-bottom: 4px; }
        .hero-stat-label { color: #666; font-size: 0.9em; }
        
        .metric-value { 
            font-size: 2.5em; 
            font-weight: bold; 
            color: #667eea; 
            text-align: center; 
            margin: 20px 0; 
        }
        .metric-label { 
            color: #666; 
            font-size: 0.9em; 
            text-align: center; 
            margin-bottom: 10px; 
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>🎓 UniVerse Backend Dashboard</h1>
        <p>Real-time Academic Management System Monitor</p>
        <div style="margin-top: 15px;">
            <button onclick="window.open('http://localhost:5556', '_blank')" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border: none; padding: 12px 24px; border-radius: 25px; cursor: pointer; font-size: 1em; transition: transform 0.3s ease;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">🗄️ View Data (Prisma Studio)</button>
        </div>
    </div>

    <div class="container">
        <div class="grid">
            <!-- Key Metrics Row -->
            <div class="card">
                <h3>👥 Total Users</h3>
                <div class="metric-value" id="totalUsers">Loading...</div>
                <div class="metric-label">System Users</div>
            </div>

            <div class="card">
                <h3>📝 Active Exams</h3>
                <div class="metric-value" id="totalExams">Loading...</div>
                <div class="metric-label">Scheduled Exams</div>
            </div>

            <div class="card">
                <h3>🪑 Seating Allocations</h3>
                <div class="metric-value" id="seatingAllocations">Loading...</div>
                <div class="metric-label">Seat Assignments</div>
            </div>

            <div class="card">
                <h3>🧠 Mind Maps</h3>
                <div class="metric-value" id="mindMaps">Loading...</div>
                <div class="metric-label">Study Materials</div>
            </div>

            <!-- System Information Row -->
            <div class="card">
                <h3>🚀 System Overview</h3>
                <div class="stat">
                    <span class="stat-label">System Health:</span>
                    <span class="stat-value">
                        <span class="status-indicator status-healthy"></span>
                        Healthy
                    </span>
                </div>
                <div class="stat">
                    <span class="stat-label">Uptime:</span>
                    <span class="stat-value" id="uptime">Loading...</span>
                </div>
                <div class="stat">
                    <span class="stat-label">Total Requests:</span>
                    <span class="stat-value" id="totalRequests">Loading...</span>
                </div>
                <div class="stat">
                    <span class="stat-label">Environment:</span>
                    <span class="stat-value"><%= process.env.NODE_ENV || 'Development' %></span>
                </div>
                <button class="refresh-btn" onclick="refreshDashboard()">🔄 Refresh Data</button>
            </div>

            <div class="card">
                <h3>📊 System Statistics</h3>
                <div id="statistics">Loading...</div>
            </div>

            <div class="card">
                <h3>🔧 Active Services</h3>
                <ul class="service-list" id="services">Loading...</ul>
            </div>

            <div class="card">
                <h3>🚨 System Alerts</h3>
                <div id="alerts">Loading...</div>
            </div>

            <!-- Full Width Cards -->
            <div class="card full-width">
                <h3>📈 Recent Activity</h3>
                <div class="recent-activity" id="recentActivity">Loading...</div>
            </div>
        </div>

        <div class="card">
            <h3>🔗 Quick API Access</h3>
            <div class="api-links">
                <a href="/api/status/health" class="api-link" target="_blank">Health Check</a>
                <a href="/api/status/status" class="api-link" target="_blank">System Status</a>
                <a href="/api/status/dashboard" class="api-link" target="_blank">Dashboard Data</a>
                <a href="/api/playground" class="api-link" target="_blank">API Playground</a>
                <a href="/api/demo/credentials" class="api-link" target="_blank">Demo Credentials</a>
                <a href="/api/demo/stats" class="api-link" target="_blank">Demo Stats</a>
                <a href="/api/courses" class="api-link" target="_blank">Courses</a>
                <a href="/api/exams" class="api-link" target="_blank">Exams</a>
                <a href="/api/seating" class="api-link" target="_blank">Seating</a>
                <a href="/api/mindmaps" class="api-link" target="_blank">Mind Maps</a>
            </div>
        </div>
    </div>

    <script>
        async function fetchDashboardData() {
            try {
                const response = await fetch('/api/status/dashboard');
                const data = await response.json();
                
                // Update hero stats
                document.getElementById('totalUsers').textContent = data.statistics.users.total;
                document.getElementById('totalExams').textContent = data.statistics.exams;
                document.getElementById('seatingAllocations').textContent = data.statistics.seatingAllocations;
                document.getElementById('mindMaps').textContent = data.statistics.mindMaps;
                
                // Update overview
                document.getElementById('uptime').textContent = data.overview.uptime;
                document.getElementById('totalRequests').textContent = data.overview.totalRequests;
                
                // Update statistics
                const statsHtml = `
                    <div class="stat"><span class="stat-label">Total Users:</span><span class="stat-value">${data.statistics.users.total}</span></div>
                    <div class="stat"><span class="stat-label">Students:</span><span class="stat-value">${data.statistics.users.students}</span></div>
                    <div class="stat"><span class="stat-label">Faculty:</span><span class="stat-value">${data.statistics.users.faculty}</span></div>
                    <div class="stat"><span class="stat-label">Active Exams:</span><span class="stat-value">${data.statistics.exams}</span></div>
                    <div class="stat"><span class="stat-label">Seating Allocations:</span><span class="stat-value">${data.statistics.seatingAllocations}</span></div>
                    <div class="stat"><span class="stat-label">Mind Maps:</span><span class="stat-value">${data.statistics.mindMaps}</span></div>
                    <div class="stat"><span class="stat-label">Clubs:</span><span class="stat-value">${data.statistics.clubs}</span></div>
                    <div class="stat"><span class="stat-label">Events:</span><span class="stat-value">${data.statistics.events}</span></div>
                `;
                document.getElementById('statistics').innerHTML = statsHtml;
                
                // Update services
                const servicesHtml = Object.entries(data.services).map(([name, service]) => `
                    <li class="service-item">
                        <span class="status-indicator status-${service.status === 'active' || service.status === 'ready' || service.status === 'connected' ? 'healthy' : 'error'}"></span>
                        ${name.charAt(0).toUpperCase() + name.slice(1)}: ${service.status}
                    </li>
                `).join('');
                document.getElementById('services').innerHTML = servicesHtml;
                
                // Update recent activity
                const activityHtml = data.recentActivity ? `
                    <h4>Recent Exams:</h4>
                    ${data.recentActivity.exams.map(exam => `
                        <div class="activity-item">📝 ${exam.course.name} (${exam.examType}) - ${new Date(exam.examDate).toLocaleDateString()}</div>
                    `).join('')}
                    <h4>Recent Events:</h4>
                    ${data.recentActivity.events.map(event => `
                        <div class="activity-item">🎭 ${event.title} - ${event.status}</div>
                    `).join('')}
                ` : '<p>No recent activity</p>';
                document.getElementById('recentActivity').innerHTML = activityHtml;
                
                // Update alerts
                const alertsHtml = data.alerts.length > 0 ? 
                    data.alerts.map(alert => `
                        <div class="alert alert-${alert.type}">${alert.message}</div>
                    `).join('') : 
                    '<div class="alert alert-info">No alerts - system running smoothly</div>';
                document.getElementById('alerts').innerHTML = alertsHtml;
                
            } catch (error) {
                console.error('Error fetching dashboard data:', error);
                document.getElementById('statistics').innerHTML = '<p>Error loading data</p>';
            }
        }
        
        function refreshDashboard() {
            fetchDashboardData();
        }
        
        // Initial load
        fetchDashboardData();
        
        // Auto-refresh every 30 seconds
        setInterval(fetchDashboardData, 30000);
    </script>
</body>
</html>