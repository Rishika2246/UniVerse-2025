    <script>
        // Tab Management
        function switchTab(tabId) {
            // Hide all tabs
            document.querySelectorAll('.tab-content').forEach(tab => {
                tab.classList.remove('active');
            });
            
            // Remove active class from all nav tabs
            document.querySelectorAll('.nav-tab').forEach(tab => {
                tab.classList.remove('active');
            });
            
            // Show selected tab
            document.getElementById(tabId).classList.add('active');
            
            // Add active class to clicked nav tab
            event.target.classList.add('active');
            
            // Load tab-specific data
            loadTabData(tabId);
        }

        // Load data for specific tab
        function loadTabData(tabId) {
            switch(tabId) {
                case 'command-center':
                    loadCommandCenterData();
                    break;
                case 'hall-tickets':
                    loadHallTicketData();
                    break;
                case 'qr-management':
                    loadQRManagementData();
                    break;
                case 'user-management':
                    loadUserManagementData();
                    break;
                case 'analytics':
                    loadAnalyticsData();
                    break;
                case 'system-config':
                    loadSystemConfigData();
                    break;
            }
        }

        // Load Hall Ticket tab data
        function loadHallTicketData() {
            setupDragAndDrop();
            // Reset form state with null checks
            const previewBtn = document.getElementById('previewBtn');
            const processBtn = document.getElementById('processBtn');
            const qrBtn = document.getElementById('qrBtn');
            const pdfBtn = document.getElementById('pdfBtn');
            
            if (previewBtn) previewBtn.disabled = true;
            if (processBtn) processBtn.disabled = true;
            if (qrBtn) qrBtn.disabled = true;
            if (pdfBtn) pdfBtn.disabled = true;
        }

        // Load QR Management data
        async function loadQRManagementData() {
            try {
                const response = await fetch('/admin/advanced/api/exam-integrity');
                const data = await response.json();
                
                // Update QR statistics
                document.getElementById('totalQRCodes').textContent = data.hallTickets?.total || '0';
                document.getElementById('scannedToday').textContent = data.hallTickets?.scannedToday || '0';
                document.getElementById('fraudAttempts').textContent = data.hallTickets?.fraudAttempts || '0';
                document.getElementById('hallOccupancy').textContent = data.liveExamStats?.hallOccupancy || '0%';
                
                // Load recent scans
                loadRecentScans();
            } catch (error) {
                console.error('Error loading QR management data:', error);
            }
        }

        // QR Management Functions
        async function refreshQRStats() {
            await loadQRManagementData();
            showAlert('success', 'QR statistics refreshed successfully!');
        }

        async function executeQROperation() {
            const operation = document.getElementById('qrOperation').value;
            if (!operation || operation === 'Select Operation') {
                showAlert('error', 'Please select an operation');
                return;
            }
            
            try {
                // Simulate operation execution
                showAlert('info', `Executing: ${operation}...`);
                
                // Here you would make actual API calls based on the operation
                setTimeout(() => {
                    showAlert('success', `${operation} completed successfully!`);
                    refreshQRStats();
                }, 2000);
                
            } catch (error) {
                showAlert('error', 'Operation failed: ' + error.message);
            }
        }

        async function emergencyQRLock() {
            if (!confirm('EMERGENCY: This will lock ALL QR codes immediately. Continue?')) {
                return;
            }
            
            try {
                // Make API call to lock all QR codes
                showAlert('warning', 'Emergency QR lock activated - All QR codes disabled');
                await refreshQRStats();
            } catch (error) {
                showAlert('error', 'Emergency lock failed: ' + error.message);
            }
        }

        async function searchQRCode() {
            const searchTerm = document.getElementById('qrSearch').value.trim();
            if (!searchTerm) {
                showAlert('error', 'Please enter a QR Code ID or Student ID');
                return;
            }
            
            const resultsDiv = document.getElementById('qrSearchResults');
            resultsDiv.innerHTML = `
                <div class="alert alert-info">
                    <span>🔍</span>
                    <div>Searching for: ${searchTerm}...</div>
                </div>
            `;
            
            try {
                // Simulate search - replace with actual API call
                setTimeout(() => {
                    resultsDiv.innerHTML = `
                        <div class="alert alert-success">
                            <span>✅</span>
                            <div>
                                <strong>QR Code Found</strong><br>
                                Student: John Doe (${searchTerm})<br>
                                Status: Active<br>
                                Last Scan: Never<br>
                                Hall: HALL-A, Seat: A-1-1
                            </div>
                        </div>
                    `;
                }, 1000);
            } catch (error) {
                resultsDiv.innerHTML = `
                    <div class="alert alert-danger">
                        <span>❌</span>
                        <div>Search failed: ${error.message}</div>
                    </div>
                `;
            }
        }

        async function loadRecentScans() {
            const recentScansDiv = document.getElementById('recentScans');
            
            try {
                // Simulate loading recent scans - replace with actual API call
                recentScansDiv.innerHTML = `
                    <div class="alert alert-info">
                        <span>📡</span>
                        <div>
                            <strong>Recent QR Scans</strong><br>
                            <div style="font-family: monospace; font-size: 0.9em; margin-top: 10px;">
                                12:34:56 - CBIT001 - HALL-A - Valid<br>
                                12:33:45 - CBIT002 - HALL-A - Valid<br>
                                12:32:12 - CBIT003 - HALL-B - Valid<br>
                                12:31:08 - CBIT004 - HALL-B - Fraud Attempt<br>
                                12:30:55 - CBIT005 - HALL-C - Valid
                            </div>
                        </div>
                    </div>
                `;
            } catch (error) {
                recentScansDiv.innerHTML = `
                    <div class="alert alert-danger">
                        <span>❌</span>
                        <div>Failed to load recent scans</div>
                    </div>
                `;
            }
        }

