        // Enhanced CSV Upload Handler
        function handleCSVUpload(event) {
            const file = event.target.files[0];
            if (!file) return;
            
            // Validate file type
            if (!file.name.toLowerCase().endsWith('.csv')) {
                showAlert('error', 'Please select a valid CSV file');
                return;
            }
            
            // Validate file size (max 10MB)
            if (file.size > 10 * 1024 * 1024) {
                showAlert('error', 'File size too large. Maximum 10MB allowed');
                return;
            }
            
            const statusDiv = document.getElementById('csvUploadStatus');
            statusDiv.innerHTML = `
                <div class="alert alert-success">
                    <span>📄</span>
                    <div>
                        <strong>File Selected: ${file.name}</strong><br>
                        Size: ${(file.size / 1024).toFixed(2)} KB<br>
                        Rows: Calculating...<br>
                        Status: Ready for preview
                    </div>
                </div>
            `;
            
            // Enable preview button
            document.getElementById('previewBtn').disabled = false;
            
            // Add drag and drop visual feedback
            const dropZone = document.getElementById('csvDropZone');
            dropZone.style.borderColor = '#4caf50';
            dropZone.style.backgroundColor = 'rgba(76, 175, 80, 0.1)';
        }

        // Drag and Drop functionality
        function setupDragAndDrop() {
            const dropZone = document.getElementById('csvDropZone');
            
            dropZone.addEventListener('dragover', (e) => {
                e.preventDefault();
                dropZone.classList.add('dragover');
            });
            
            dropZone.addEventListener('dragleave', (e) => {
                e.preventDefault();
                dropZone.classList.remove('dragover');
            });
            
            dropZone.addEventListener('drop', (e) => {
                e.preventDefault();
                dropZone.classList.remove('dragover');
                
                const files = e.dataTransfer.files;
                if (files.length > 0) {
                    document.getElementById('csvUpload').files = files;
                    handleCSVUpload({ target: { files: files } });
                }
            });
        }

