        // Start progress monitoring
        function startProgressMonitoring(jobId) {
            if (progressInterval) {
                clearInterval(progressInterval);
            }
            
            progressInterval = setInterval(async () => {
                try {
                    const response = await fetch(`/admin/advanced/api/hall-tickets/job-status/${jobId}`);
                    const result = await response.json();
                    
                    if (result.success) {
                        updateProgressDisplay(result.job, result.recentLogs);
                        
                        // Stop monitoring if job is complete
                        if (result.job.status === 'COMPLETED' || result.job.status === 'FAILED') {
                            clearInterval(progressInterval);
                            onJobComplete(result.job);
                        }
                    }
                } catch (error) {
                    console.error('Progress monitoring error:', error);
                }
            }, 2000); // Update every 2 seconds
        }

        // Update progress display
        function updateProgressDisplay(job, recentLogs) {
            // Update progress bar
            const progressBar = document.getElementById('progressBar');
            const progressText = document.getElementById('progressText');
            
            progressBar.style.width = `${job.progress}%`;
            progressText.textContent = `${job.progress}% Complete`;
            
            // Update live stats
            document.getElementById('liveProcessed').textContent = job.processedRows;
            document.getElementById('liveSuccess').textContent = job.successRows;
            document.getElementById('liveFailed').textContent = job.failedRows;
            
            // Calculate ETA
            if (job.progress > 0 && job.status === 'PROCESSING') {
                const elapsed = new Date() - new Date(job.startedAt);
                const remaining = (elapsed / job.progress) * (100 - job.progress);
                const eta = Math.round(remaining / 1000 / 60); // minutes
                document.getElementById('liveETA').textContent = eta > 0 ? `${eta}m` : '<1m';
            } else {
                document.getElementById('liveETA').textContent = '--';
            }
            
            // Update progress bar color based on status
            progressBar.className = 'progress-bar ' + 
                (job.status === 'COMPLETED' ? 'progress-excellent' : 
                 job.status === 'FAILED' ? 'progress-critical' : 'progress-good');
            
            // Update live log
            const liveLog = document.getElementById('liveLog');
            if (recentLogs && recentLogs.length > 0) {
                const logEntries = recentLogs.map(log => {
                    const status = log.status === 'SUCCESS' ? '✅' : '❌';
                    const time = new Date(log.createdAt).toLocaleTimeString();
                    return `[${time}] ${status} Row ${log.rowNumber}: ${log.studentId || 'Unknown'} - ${log.status}${log.errorMessage ? ` (${log.errorMessage})` : ''}`;
                }).join('\n');
                
                liveLog.innerHTML = `<pre style="margin: 0; white-space: pre-wrap;">${logEntries}</pre>`;
                liveLog.scrollTop = liveLog.scrollHeight;
            }
        }

        // Handle job completion
        function onJobComplete(job) {
            const statusDiv = document.getElementById('processingStatus');
            
            if (job.status === 'COMPLETED') {
                statusDiv.innerHTML = `
                    <div class="alert alert-success">
                        <span>🎉</span>
                        <div>
                            <strong>Bulk Processing Completed Successfully!</strong><br>
                            📊 Total Processed: ${job.processedRows}<br>
                            ✅ Successful: ${job.successRows}<br>
                            ❌ Failed: ${job.failedRows}<br>
                            ⏱️ Duration: ${calculateDuration(job.startedAt, job.completedAt)}
                        </div>
                    </div>
                `;
                
                showAlert('success', `🎉 Bulk processing completed! ${job.successRows} hall tickets generated successfully.`);
                
                // Show download options
                if (job.failedRows > 0) {
                    showFailedRowsDownload(job.id);
                }
                
            } else if (job.status === 'FAILED') {
                statusDiv.innerHTML = `
                    <div class="alert alert-danger">
                        <span>❌</span>
                        <div>
                            <strong>Bulk Processing Failed</strong><br>
                            Error: ${job.errorSummary}<br>
                            📊 Processed: ${job.processedRows}<br>
                            ✅ Successful: ${job.successRows}<br>
                            ❌ Failed: ${job.failedRows}
