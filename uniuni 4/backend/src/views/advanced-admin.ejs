        // Open Prisma Studio
        let prismaStudioOpening = false;
        function openPrismaStudio() {
            // Prevent multiple simultaneous clicks
            if (prismaStudioOpening) {
                return;
            }
            
            prismaStudioOpening = true;
            const button = document.getElementById('prismaStudioBtn');
            if (button) {
                button.disabled = true;
                button.innerHTML = '⏳ Opening...';
            }
            
            // First try to start Prisma Studio if not running
            fetch('/api/admin-dashboard/prisma-studio/start', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Open Prisma Studio in new tab
                    const prismaUrl = data.url || 'http://localhost:5556';
                    window.open(prismaUrl, '_blank');
                    
                    // Show success message
                    const alertDiv = document.createElement('div');
                    alertDiv.className = 'alert alert-success';
                    alertDiv.innerHTML = `
                        <div class="alert-content">
                            <span class="alert-icon">✅</span>
                            <div class="alert-text">
                                <strong>Prisma Studio Opened</strong>
                                <p>Database viewer opened in new tab at ${prismaUrl}</p>
                            </div>
                        </div>
                    `;
                    
                    const mainContainer = document.querySelector('.main-container');
                    mainContainer.insertBefore(alertDiv, mainContainer.firstChild);
                    
                    // Remove alert after 5 seconds
                    setTimeout(() => {
                        alertDiv.remove();
                    }, 5000);
                } else {
                    throw new Error(data.message || 'Failed to start Prisma Studio');
                }
                
                // Reset button state
                prismaStudioOpening = false;
                if (button) {
                    button.disabled = false;
                    button.innerHTML = '🗄️ View Data';
                }
            })
            .catch(error => {
                console.error('Error opening Prisma Studio:', error);
                
                // Show error message
                const alertDiv = document.createElement('div');
                alertDiv.className = 'alert alert-error';
                alertDiv.innerHTML = `
                    <div class="alert-content">
                        <span class="alert-icon">❌</span>
                        <div class="alert-text">
                            <strong>Error Opening Prisma Studio</strong>
                            <p>${error.message}</p>
                            <p>Try opening manually: <a href="http://localhost:5556" target="_blank">http://localhost:5556</a></p>
                        </div>
                    </div>
                `;
                
                const mainContainer = document.querySelector('.main-container');
                mainContainer.insertBefore(alertDiv, mainContainer.firstChild);
                
                // Remove alert after 8 seconds
                setTimeout(() => {
                    alertDiv.remove();
                }, 8000);
                
                // Reset button state
                prismaStudioOpening = false;
                if (button) {
                    button.disabled = false;
                    button.innerHTML = '🗄️ View Data';
                }
            });
        }
